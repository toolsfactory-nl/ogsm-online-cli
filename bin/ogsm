#!/usr/bin/env ruby
# frozen_string_literal: true

require "net/http"
require "json"
require "optparse"
require "uri"
require "io/console"
require "fileutils"

# Agents often run under a C/POSIX locale, where ARGV arrives as binary and
# JSON.generate rejects any non-ASCII text.
Encoding.default_external = Encoding::UTF_8
ARGV.map! { |arg| arg.dup.force_encoding(Encoding::UTF_8) }

# --- Paths ----------------------------------------------------------------

CONFIG_DIR = File.join(ENV["XDG_CONFIG_HOME"] || File.join(Dir.home, ".config"), "ogsm-online")
CREDENTIALS_FILE = File.join(CONFIG_DIR, "credentials.json")
SETTINGS_FILE = File.join(CONFIG_DIR, "settings.json")

# --- Global option parsing ------------------------------------------------

url_arg = nil
OptionParser.new do |o|
  o.on("--url URL", "Tenant URL (e.g. tenant.ogsm.online or http://localhost:8350)") { |v| url_arg = v }
end.order!(ARGV)

# --- Settings (url) -------------------------------------------------------

def load_settings
  return {} unless File.exist?(SETTINGS_FILE)
  JSON.parse(File.read(SETTINGS_FILE))
rescue JSON::ParserError
  {}
end

def save_settings(settings)
  FileUtils.mkdir_p(CONFIG_DIR, mode: 0o700)
  File.write(SETTINGS_FILE, JSON.pretty_generate(settings))
end

def normalise_url(value)
  uri = URI.parse(value.include?("://") ? value : "https://#{value}")
  abort "Invalid --url: #{value}" unless uri.is_a?(URI::HTTP) && uri.host
  port_part = (uri.port && uri.port != uri.default_port) ? ":#{uri.port}" : ""
  "#{uri.scheme}://#{uri.host}#{port_part}"
end

def resolve_url(url_arg)
  return URI.parse(normalise_url(ENV["OGSM_URL"])) if url_arg.nil? && ENV["OGSM_URL"]

  settings = load_settings
  url = url_arg ? normalise_url(url_arg) : settings["url"]
  abort "No url known — pass --url=tenant.ogsm.online at least once, or set OGSM_URL" if url.nil?

  updated = {"url" => url}
  save_settings(updated) unless settings == updated

  URI.parse(url)
end

URI_OBJECT = resolve_url(url_arg)
HOST = URI_OBJECT.host
PORT = URI_OBJECT.port || ((URI_OBJECT.scheme == "https") ? 443 : 80)
USE_SSL = URI_OBJECT.scheme == "https"

# --- Token storage --------------------------------------------------------

def load_credentials
  return {} unless File.exist?(CREDENTIALS_FILE)
  JSON.parse(File.read(CREDENTIALS_FILE))
rescue JSON::ParserError
  {}
end

def save_credentials(creds)
  FileUtils.mkdir_p(CONFIG_DIR, mode: 0o700)
  File.open(CREDENTIALS_FILE, File::WRONLY | File::CREAT | File::TRUNC, 0o600) do |f|
    f.write(JSON.pretty_generate(creds))
  end
end

def stored_token
  return ENV["OGSM_TOKEN"] if ENV["OGSM_TOKEN"]
  load_credentials.dig(HOST, "token")
end

def store_token(token)
  return if ENV["OGSM_TOKEN"]
  creds = load_credentials
  creds[HOST] = {"token" => token}
  save_credentials(creds)
end

def clear_token
  return if ENV["OGSM_TOKEN"]
  creds = load_credentials
  creds.delete(HOST)
  save_credentials(creds)
end

# --- HTTP layer -----------------------------------------------------------

def http_request(method_class, path, body: nil, token: stored_token)
  Net::HTTP.start(HOST, PORT, use_ssl: USE_SSL) do |http|
    req = method_class.new("/api/v3/#{path}")
    req["Authorization"] = "Bearer #{token}" if token
    if body
      req.content_type = "application/json"
      req.body = JSON.generate(body)
    end
    http.request(req)
  end
end

def request(method_class, path, body: nil)
  ensure_token!
  res = http_request(method_class, path, body: body)
  if res.code.to_i == 401
    warn "Authentication failed; logging in again."
    clear_token
    ensure_token!
    res = http_request(method_class, path, body: body)
  end
  res
end

def get(path) = request(Net::HTTP::Get, path)

def post(path, body) = request(Net::HTTP::Post, path, body:)

def patch(path, body) = request(Net::HTTP::Patch, path, body:)

def ok!(res)
  unless res.is_a?(Net::HTTPSuccess)
    abort "Error #{res.code}: #{res.body}"
  end
  JSON.parse(res.body)
end

# Long markup, such as an embedded base64 image, does not fit in a single argument.
def read_text(path)
  text = (path == "-") ? $stdin.read : File.read(path)
  text.force_encoding(Encoding::UTF_8)
rescue SystemCallError => e
  abort e.message
end

def get_all(path)
  separator = path.include?("?") ? "&" : "?"
  records = []
  page = 1
  while page
    body = ok!(get("#{path}#{separator}page=#{page}"))
    records.concat(body["data"])
    page = body.dig("meta", "next_page")
  end
  records
end

# --- Login ----------------------------------------------------------------

def prompt(label)
  $stderr.print(label)
  $stdin.gets&.chomp
end

def prompt_secret(label)
  $stderr.print(label)
  result = $stdin.noecho(&:gets)&.chomp
  $stderr.puts
  result
end

def ensure_token!
  return if stored_token
  abort "Not logged in to #{HOST} — run `ogsm login` in a terminal, or set OGSM_TOKEN" unless $stdin.tty?

  warn "Logging in to #{HOST}"
  email = prompt("Email: ")
  password = prompt_secret("Password: ")
  abort "Email and password are required" if email.to_s.empty? || password.to_s.empty?

  body = {email_address: email, password: password}
  loop do
    res = http_request(Net::HTTP::Post, "session.json", body: body, token: nil)
    case res.code.to_i
    when 200
      data = JSON.parse(res.body)
      store_token(data["token"])
      warn "Logged in as #{data.dig("user", "email_address")}"
      return
    when 401
      reason = (begin
        JSON.parse(res.body)["error"]
      rescue
        nil
      end)
      if reason == "otp_required"
        body[:otp] = prompt("OTP code: ")
        next
      end
      abort "Login failed: invalid credentials"
    when 429
      abort "Login failed: rate limited"
    else
      abort "Login failed (#{res.code}): #{res.body}"
    end
  end
end

# --- Commands -------------------------------------------------------------

command = ARGV.shift

case command

when "login"
  clear_token
  ensure_token!

when "logout"
  clear_token
  warn "Removed stored credentials for #{HOST}"

when "list"
  canvas_id = nil
  OptionParser.new do |o|
    o.on("--canvas-id ID") { |v| canvas_id = v }
  end.parse!(ARGV)

  abort "--canvas-id is required" unless canvas_id

  actions = get_all("actions.json?canvas_id=#{canvas_id}")
  puts JSON.generate(actions)

when "statuses"
  statuses = get_all("statuses.json")
  puts JSON.generate(statuses)

when "create"
  opts = {list: "todo"}
  OptionParser.new do |o|
    o.on("--canvas-id ID") { |v| opts[:canvas_id] = v }
    o.on("--title TITLE") { |v| opts[:title] = v }
    o.on("--description TEXT") { |v| opts[:description] = v }
    o.on("--description-file PATH") { |v| opts[:description] = read_text(v) }
    o.on("--strategy-id ID") { |v| opts[:strategy_id] = v }
    o.on("--due DATE") { |v| opts[:due] = v }
    o.on("--start DATE") { |v| opts[:start] = v }
    o.on("--list STATUS") { |v| opts[:list] = v }
    o.on("--assignee USER_ID") { |v| opts[:assignee_id] = v }
    o.on("--labels LABELS") { |v| opts[:label_ids] = v.split(",") }
  end.parse!(ARGV)

  abort "--canvas-id is required" unless opts[:canvas_id]
  abort "--title is required" unless opts[:title]

  body = {canvas: {id: opts[:canvas_id]}, title: opts[:title]}
  body[:description] = opts[:description] if opts[:description]
  body[:strategy] = {id: opts[:strategy_id]} if opts[:strategy_id]
  body[:due] = opts[:due] if opts[:due]
  body[:start] = opts[:start] if opts[:start]
  body[:list] = opts[:list] if opts[:list]
  body[:assignee_id] = opts[:assignee_id] if opts[:assignee_id]
  body[:label_ids] = opts[:label_ids] if opts[:label_ids]

  action = ok!(post("actions.json", {ogsm_action: body}))
  puts JSON.generate(action)

when "update"
  action_id = ARGV.shift or abort "Usage: ogsm update ACTION_ID [options]"
  opts = {}
  OptionParser.new do |o|
    o.on("--title TITLE") { |v| opts[:title] = v }
    o.on("--description TEXT") { |v| opts[:description] = v }
    o.on("--description-file PATH") { |v| opts[:description] = read_text(v) }
    o.on("--due DATE") { |v| opts[:due] = v }
    o.on("--list STATUS") { |v| opts[:list] = v }
    o.on("--assignee USER_ID") { |v| opts[:assignee_id] = v }
    o.on("--labels LABELS") { |v| opts[:label_ids] = v.split(",") }
  end.parse!(ARGV)

  body = {}
  body[:title] = opts[:title] if opts[:title]
  body[:description] = opts[:description] if opts[:description]
  body[:due] = opts[:due] if opts[:due]
  body[:list] = opts[:list] if opts[:list]
  body[:assignee_id] = opts[:assignee_id] if opts[:assignee_id]
  body[:label_ids] = opts[:label_ids] if opts[:label_ids]

  action = ok!(patch("actions/#{action_id}.json", {ogsm_action: body}))
  puts JSON.generate(action)

when "comments"
  action_id = ARGV.shift or abort "Usage: ogsm comments ACTION_ID"
  comments = get_all("actions/#{action_id}/comments.json")
  puts JSON.generate(comments)

when "comment-create"
  action_id = ARGV.shift or abort "Usage: ogsm comment-create ACTION_ID --content CONTENT"
  opts = {}
  OptionParser.new do |o|
    o.on("--content CONTENT") { |v| opts[:content] = v }
    o.on("--content-file PATH") { |v| opts[:content] = read_text(v) }
  end.parse!(ARGV)

  abort "--content or --content-file is required" unless opts[:content]

  comment = ok!(post("actions/#{action_id}/comments.json", {comment: {content: opts[:content]}}))
  puts JSON.generate(comment)

when "comment-update"
  action_id = ARGV.shift or abort "Usage: ogsm comment-update ACTION_ID COMMENT_ID --content CONTENT"
  comment_id = ARGV.shift or abort "Usage: ogsm comment-update ACTION_ID COMMENT_ID --content CONTENT"
  opts = {}
  OptionParser.new do |o|
    o.on("--content CONTENT") { |v| opts[:content] = v }
    o.on("--content-file PATH") { |v| opts[:content] = read_text(v) }
  end.parse!(ARGV)

  abort "--content or --content-file is required" unless opts[:content]

  comment = ok!(patch("actions/#{action_id}/comments/#{comment_id}.json", {comment: {content: opts[:content]}}))
  puts JSON.generate(comment)

else
  abort <<~USAGE
    Usage:
      ogsm [--url=URL] COMMAND [options]

    Commands:
      login
      logout
      list --canvas-id ID
      statuses
      create --canvas-id ID --title TITLE [--description TEXT | --description-file PATH] [--strategy-id ID] [--due DATE] [--start DATE] [--list STATUS]
             [--assignee USER_ID] [--labels "name1,name2"]
      update ACTION_ID [--title TITLE] [--description TEXT | --description-file PATH] [--due DATE] [--list STATUS]
             [--assignee USER_ID] [--labels "name1,name2"]

    --list takes a status id, name or base list key ("backlog", "todo", "doing", "done");
    run "statuses" to see the statuses this environment uses.
      comments ACTION_ID
      comment-create ACTION_ID (--content CONTENT | --content-file PATH)
      comment-update ACTION_ID COMMENT_ID (--content CONTENT | --content-file PATH)

    --description-file and --content-file read the text from a file, or from stdin when PATH is "-".
    Descriptions and comments are HTML; an <img> with a base64 data URI as its src is stored as an
    attachment.

    --url accepts a hostname (assumes HTTPS) or a full URL such as http://localhost:8350.
    On first use, pass --url; it is persisted to
    $XDG_CONFIG_HOME/ogsm-online/settings.json. Credentials live alongside in
    credentials.json (mode 0600). Set OGSM_URL and OGSM_TOKEN to use neither file,
    for example in CI or a cloud session.
  USAGE
end
