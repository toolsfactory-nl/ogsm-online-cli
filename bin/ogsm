#!/usr/bin/env ruby
# frozen_string_literal: true

require "net/http"
require "json"
require "optparse"
require "uri"

# --- Config ---------------------------------------------------------------

uri     = URI.parse(ENV.fetch("OGSM_URL"))
params  = URI.decode_www_form(uri.query.to_s).to_h

HOST      = uri.host
PORT      = uri.port || (uri.scheme == "https" ? 443 : 80)
USE_SSL   = uri.scheme == "https"
USERNAME  = uri.user
PASSWORD  = URI.decode_www_form_component(uri.password.to_s)
CANVAS_ID = params["canvas_id"] or abort "OGSM_URL missing canvas_id param"
USER_ID   = params["user_id"]  or abort "OGSM_URL missing user_id param"

# --- HTTP helpers ---------------------------------------------------------

def request(method_class, path, body: nil)
  Net::HTTP.start(HOST, PORT, use_ssl: USE_SSL) do |http|
    req = method_class.new("/api/v2/#{path}")
    req.basic_auth USERNAME, PASSWORD
    if body
      req.content_type = "application/json"
      req.body = JSON.generate(body)
    end
    http.request(req)
  end
end

def get(path)         = request(Net::HTTP::Get,   path)
def post(path, body)  = request(Net::HTTP::Post,  path, body:)
def patch(path, body) = request(Net::HTTP::Patch, path, body:)

def ok!(res)
  unless res.is_a?(Net::HTTPSuccess)
    abort "Error #{res.code}: #{res.body}"
  end
  JSON.parse(res.body)
end

# --- Commands -------------------------------------------------------------

command = ARGV.shift

case command

when "list"
  actions = ok!(get("actions.json?canvas_id=#{CANVAS_ID}"))
  puts JSON.generate(actions)

when "create"
  opts = { canvas_id: CANVAS_ID }
  OptionParser.new do |o|
    o.on("--title TITLE")       { |v| opts[:title]       = v }
    o.on("--strategy-id ID")    { |v| opts[:strategy_id] = v }
    o.on("--due DATE")          { |v| opts[:due]         = v }
    o.on("--start DATE")        { |v| opts[:start]       = v }
    o.on("--list STATUS")       { |v| opts[:list]        = v }
  end.parse!(ARGV)

  abort "--title is required" unless opts[:title]

  body = { canvas: { id: opts[:canvas_id] }, creator: { id: USER_ID }, title: opts[:title] }
  body[:strategy] = { id: opts[:strategy_id] } if opts[:strategy_id]
  body[:due]      = opts[:due]   if opts[:due]
  body[:start]    = opts[:start] if opts[:start]
  body[:list]     = opts[:list]  if opts[:list]

  action = ok!(post("actions.json", { ogsm_action: body }))
  puts "Created #{action["id"]}: #{action["title"]}"

when "update"
  action_id = ARGV.shift or abort "Usage: ogsm-actions update ACTION_ID [options]"
  opts = {}
  OptionParser.new do |o|
    o.on("--title TITLE")    { |v| opts[:title] = v }
    o.on("--due DATE")       { |v| opts[:due]   = v }
    o.on("--list STATUS")    { |v| opts[:list]  = v }
  end.parse!(ARGV)

  body = { updater: { id: USER_ID } }
  body[:title] = opts[:title] if opts[:title]
  body[:due]   = opts[:due]   if opts[:due]
  body[:list]  = opts[:list]  if opts[:list]

  action = ok!(patch("actions/#{action_id}.json", { ogsm_action: body }))
  puts "Updated #{action["id"]}: #{action["title"]}"

else
  abort <<~USAGE
    Usage:
      ogsm-actions list
      ogsm-actions create --title TITLE [--strategy-id ID] [--due DATE] [--start DATE] [--list STATUS]
      ogsm-actions update ACTION_ID [--title TITLE] [--due DATE] [--list STATUS]

    Configure via OGSM_URL=https://user:pass@host/?canvas_id=CANVAS_ID&user_id=USER_ID
  USAGE
end
